{
  "description": "agent-guard: blocks destructive commands, secret leaks and self-disabling edits before the agent runs them",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/agent-guard.mjs\" hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
